# Default/production behavior loads only clinically ACTIVE content.
PREP_MEDS_CONTENT_MODE=production

# Internal validation only. Enables Stage 8.5 clinical-review candidate rules in
# deterministic-engine VALIDATION mode and disables all patient instructions.
# PREP_MEDS_CONTENT_MODE=shadow

# Read-only operational owner dashboard connection (server-side only).
PREPMEDS_SUPABASE_URL=https://your-project.supabase.co
PREPMEDS_PUBLISHABLE_KEY=sb_publishable_replace_me
