# Default/production behavior loads only clinically ACTIVE content.
PREP_MEDS_CONTENT_MODE=production

# Internal validation only. Enables Stage 8.5 clinical-review candidate rules in
# deterministic-engine VALIDATION mode and disables all patient instructions.
# PREP_MEDS_CONTENT_MODE=shadow

# Clinical evidence review; separate from patient-facing activation. Server-only.
PREP_MEDS_CLINICIAN_REVIEW=disabled
PREP_MEDS_REVIEW_ORIGIN=
PREP_MEDS_REVIEW_CLIENT_ID=
PREP_MEDS_REVIEW_CLIENT_SECRET=
PREP_MEDS_REVIEW_SESSION_KEY=
PREP_MEDS_REVIEW_AUDIT_KEY=
PREP_MEDS_REVIEW_STORE_TOKEN=
PREP_MEDS_CLINICIAN_GITHUB_IDS=
