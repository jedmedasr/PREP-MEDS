export type InventoryItem = { id: string; ingredientIds: string[]; formulation: string };
export type Patient = { synthetic: boolean; medicationId: string; formulation: string; procedure: {setting:string;code:string;bleedingRisk:string;thromboticRisk:string}; procedureDate:string;procedureEndDate:string;timeZone:string;renal:{metric:string;value:number;unit:string};conditions:Record<string, boolean>;procedureStart?:string;procedureEnd?:string };
export type Timing = { action:string;min:number|null;max:number|null;unit:string;anchor:string };
export type ComparisonRow = { id:string;society:string;published:string;sourceUrl:string;sourceHash:string;status:string;selectable:boolean;reasons:string[];passages:Array<{field:string;quote:string;location:string}>;applicability:{applicable:boolean;reasons:string[]};rule:{id:string;version:string;origin:string;formulation:string;hold:Timing;resume:Timing;bridging:string;renal:{metric:string;min:number|null;max:number|null;unit:string;lowerInclusive:boolean;upperInclusive:boolean};exceptions:string[];certainty:{strength:string;evidence:string}} };
export type Selection = { recordId:string;clinicianId:string;decisionId:string;decidedAt?:string;holdAmount?:number;resumeAmount?:number };
export type Preview = { text:string;eventHash:string;warning:string;decidedAt:string;source:{url:string;hash:string;society:string;published:string};ruleId:string;ruleVersion:string;ruleHash:string;patientInputs:Patient;clinicianId:string;decisionId:string;[key:string]:unknown };
export function comparison(records:unknown[],patient:Patient,inventory:InventoryItem[],currentHashes:Record<string,string>):ComparisonRow[];
export function instructionPreview(records:unknown[],selection:Selection,patient:Patient,inventory:InventoryItem[],currentHashes:Record<string,string>,options?:{mode:string}):Preview;
